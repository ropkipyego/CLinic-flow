# ClinicFlow environment template
# Copy to .env.development / .env.staging / .env.production
# NEVER commit real secrets.

NODE_ENV=development
APP_NAME=ClinicFlow
APP_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5174
API_PREFIX=/api/v1

# PostgreSQL — do not expose this port publicly in production
DATABASE_URL=postgresql://clinicflow:clinicflow@localhost:5434/clinicflow

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
PASSWORD_RESET_EXPIRES_MINUTES=30
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

# Email — disabled by default. Do not enable in development against live providers.
EMAIL_ENABLED=false
EMAIL_PROVIDER=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=ClinicFlow

# SMS — disabled by default. Do not enable in development against live providers.
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=

# Object storage abstraction (local disk for development)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# Worker
SMS_WORKER_POLL_MS=3000
SMS_MAX_ATTEMPTS=3

# Seed — never run against production
SEED_ON_START=false
